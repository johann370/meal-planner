# node_modules holds all the external packages for the project. They don't have to get committed because they can all be installed later through npm. 
node_modules/


# .env holds all the environment variables for the project, this is sensitive information so we wouldn't want to commit it.
.env

# cookies.txt is curl's cookie-jar output (e.g. curl -c cookies.txt) from testing
# login/session routes by hand. It's disposable test output, not app code.
cookies.txt